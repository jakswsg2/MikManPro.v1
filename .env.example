# ===== General =====
ENVIRONMENT=development
TZ=Asia/Aden

# ===== Django =====
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=CHANGE_ME_32_CHARS_MIN_SECURE_SECRET
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ===== JWT =====
JWT_SIGNING_KEY=CHANGE_ME_ANOTHER_32_CHARS_JWT_KEY

# ===== Encryption =====
FERNET_KEY=CHANGE_ME_GENERATE_WITH_python_c_-c_from_cryptography.fernet_import_Fernet_Fernet.generate_key
HMAC_PLAYBACK_KEY=CHANGE_ME_HMAC_PLAYBACK_KEY

# ===== Database =====
POSTGRES_DB=lounge
POSTGRES_USER=lounge
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===== Frontend =====
VITE_API_URL=/api/v1
VITE_APP_NAME=Smart Lounge
VITE_DEFAULT_LANG=ar

# ===== Nginx =====
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===== Gunicorn =====
GUNICORN_WORKERS=4
GUNICORN_THREADS=4

# ===== Celery =====
CELERY_CONCURRENCY=4

# ===== Backup =====
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_KEY
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 3 * * *
BACKUP_S3_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=

# ===== Monitoring =====
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME

# ===== Image =====
IMAGE_TAG=latest

# ===== Phase 15: External Metadata Providers =====
TMDB_API_KEY=
TVDB_API_KEY=
METADATA_CACHE_TTL_DAYS=30
METADATA_DEFAULT_LANGUAGE=ar
METADATA_FALLBACK_LANGUAGE=en
