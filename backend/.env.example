# Smart Lounge — Environment Configuration
DEBUG=True
SECRET_KEY=change-me-in-production-secure-random-key-12345
JWT_SIGNING_KEY=change-me-in-production-jwt-dedicated-signing-key-67890
ALLOWED_HOSTS=*

# PostgreSQL 16
DATABASE_URL=postgresql://lounge_user:lounge_secret_2026@127.0.0.1:5432/smart_lounge_db
POSTGRES_DB=smart_lounge_db
POSTGRES_USER=lounge_user
POSTGRES_PASSWORD=lounge_secret_2026

# Redis 7 & Celery
REDIS_URL=redis://127.0.0.1:6379/0

# Default LAN Gateway & Media Server Defaults
DEFAULT_MEDIA_SERVER_URL=http://192.168.1.50:8096
DEFAULT_MEDIA_SERVER_KEY=your_jellyfin_api_key_here
TIME_ZONE=Asia/Aden
LANGUAGE_CODE=ar

# Phase 15: External Metadata Providers (TMDB, TVDB)
TMDB_API_KEY=
TVDB_API_KEY=
METADATA_CACHE_TTL_DAYS=30
METADATA_DEFAULT_LANGUAGE=ar
METADATA_FALLBACK_LANGUAGE=en

# OmniRoute AI gateway
# Generate strong random values for all secret fields before production use.
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
OMNIROUTE_TIMEOUT_SECONDS=90
OMNIROUTE_MEMORY_MB=1024
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_INITIAL_PASSWORD=change-this-before-first-run
OMNIROUTE_STORAGE_ENCRYPTION_KEY=
OMNIROUTE_WS_BRIDGE_SECRET=
